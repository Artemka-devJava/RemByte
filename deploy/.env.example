# ============================================================
# deploy/.env — конфигурация запуска FixByte CRM через Docker
# Скопируйте в deploy/.env и отредактируйте:
#   cp .env.example .env
# ============================================================

# ── Учётные данные ────────────────────────────────────────
MARIADB_PASSWORD=changeme

FIXBYTE_ADMIN_USERNAME=admin
FIXBYTE_ADMIN_PASSWORD=changeme

FIXBYTE_OPERATOR_USERNAME=operator
FIXBYTE_OPERATOR_PASSWORD=changeme

# ── Обычный режим (bridge, docker-compose.yml) ────────────
# На каком порту хоста слушать веб-интерфейс:
HOST_HTTP_PORT=9087

# ── Хранилище полных бэкапов ──────────────────────────────
# Каталог внутри контейнера, куда админ-панель складывает ПОЛНЫЕ бэкапы.
# Пусто = хранилище выключено (доступно только скачивание в браузер).
# Смонтируйте сюда шару Samba/CIFS — см. deploy/backups/README.md.
FIXBYTE_BACKUP_DIR=/backups
# Сколько последних полных бэкапов держать (старые удаляются). 0 = не удалять.
FIXBYTE_BACKUP_KEEP=14
# Плановый полный бэкап (cron из 6 полей). '-' = выключено.
# Пример каждую ночь в 03:30:  0 30 3 * * *
FIXBYTE_BACKUP_CRON=-
# Куда на ХОСТЕ складывать бэкапы (для варианта с bind-mount, а не CIFS-volume).
BACKUP_HOST_DIR=./backups

# ── Режим macvlan (docker-compose.macvlan.yml, только Linux) ──
# Контейнер получает свой IP в вашей локальной сети.
# Родительский сетевой интерфейс Linux-хоста (ip -o link show): eth0 / enp3s0 / eno1 ...
MACVLAN_PARENT=eth0
# Параметры вашей LAN (как на роутере):
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
# Блок адресов, который роутер НЕ раздаёт по DHCP:
LAN_IP_RANGE=192.168.1.240/28
# Фиксированный IP контейнера CRM — по нему заходят телефоны:  http://192.168.1.242:9087
CRM_IP=192.168.1.242
# IP для доступа самого Docker-хоста к контейнеру (см. macvlan/host-shim.sh):
HOST_SHIM_IP=192.168.1.241
