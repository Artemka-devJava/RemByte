# ============================================================
# .env.macvlan — пример переменных для docker-compose.macvlan.yml
# Скопируйте в .env и отредактируйте под свою сеть:
#   cp .env.macvlan .env
# ============================================================

# ── Сеть macvlan ──────────────────────────────────────────
# Родительский сетевой интерфейс Linux-хоста.
# Посмотреть:  ip -o link show
# Примеры: eth0, enp3s0, eno1, end0, bond0.  Wi-Fi обычно НЕ подходит.
MACVLAN_PARENT=eth0

# Параметры вашей локальной сети (как на роутере)
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# Небольшой блок адресов, который роутер НЕ раздаёт по DHCP
# (сузьте DHCP-пул на роутере, чтобы не было конфликтов).
# /28 = 16 адресов: 192.168.1.240 – 192.168.1.255
LAN_IP_RANGE=192.168.1.240/28

# Фиксированный IP контейнера CRM — по нему заходят телефоны и браузер:
#   http://192.168.1.242:9087
CRM_IP=192.168.1.242

# IP для shim-интерфейса Docker-хоста (чтобы сам хост видел контейнер).
# Должен быть в LAN_IP_RANGE и не совпадать с CRM_IP.
HOST_SHIM_IP=192.168.1.241

# ── Учётные данные (как в .env.docker) ────────────────────
MARIADB_PASSWORD=sdim69q

FIXBYTE_ADMIN_USERNAME=admin
FIXBYTE_ADMIN_PASSWORD=sdim69q

FIXBYTE_OPERATOR_USERNAME=operator
FIXBYTE_OPERATOR_PASSWORD=sdim69q
